            uniform token subdivisionScheme = "none"
            double3 xformOp:translate = (0, 0, 0.745)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Scope "lights"
    {
        # Primary ceiling light.
        # Renamed to DiskLight for drop-in compat with LiftCubeSceneCfg.room_light.
        def DiskLight "DiskLight"
        {
            float inputs:colorTemperature = 6500
            bool inputs:enableColorTemperature = 1
            float inputs:intensity = 15000
            float inputs:radius = 0.75
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 2.92)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        # Dim ambient dome so shadowed regions are not pitch-black. The room is a
        # closed opaque cylinder (no windows) → the dome is not visible to the
        # cameras, it only lifts the ambient floor. Present so LiftCubeSceneCfg.env_light
        # prim-path resolves (avoids XformPrimView registration failure).
        def DomeLight "DomeLight"
        {
            float inputs:intensity = 300
            color3f inputs:color = (1, 1, 1)
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }
}
